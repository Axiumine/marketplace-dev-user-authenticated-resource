PORT=4032
DOMAIN=xxx.tdweb.lan

REDIS_IS_CLUSTER=1
#
# Read ONLY when REDIS_IS_CLUSTER is not exactly the string '1'. koa-utils then builds a single-node
# createClient({ url: resolveRedisUrl(REDIS_URL) }) and ignores every REDIS_DB1..DB3 pair below. Empty
# because this stack runs the cluster branch — but an empty value is not an error on the other branch:
# node-redis falls back to redis://localhost:6379 and connects to the wrong server instead of refusing.
# Set it before flipping REDIS_IS_CLUSTER.
#
# ⚠️ REDIS_TLS is deliberately absent from this file and must stay absent here. koa-utils reads it since
# 7.1.0: set to exactly the string 'true' it builds the cluster rootNodes as rediss://, carries TLS to
# the nodes discovered behind them, and makes resolveRedisUrl refuse a REDIS_URL that is not rediss:// —
# throwing at module load rather than connecting. Every other value, unset included, is off, which is
# what leaves this leg cleartext (R45). The Redis this workspace runs serves no TLS listener.
REDIS_URL=
REDIS_DB1_HOST=db1
REDIS_DB2_HOST=db2
REDIS_DB3_HOST=db3
REDIS_DB1_PORT=6379
REDIS_DB2_PORT=6379
REDIS_DB3_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY=marketplaceDev:

MONGODB_URI=mongodb+srv://adminxxx:pwd@rs0.gio.lan/testRnApollo?ssl=false

# ── Field encryption (ADR-029) ────────────────────────────────────────────────
#
# Both are required at boot: src/index.mts lists them in REQUIRED_ENV_VARS and calls
# setupFieldEncryption() straight after MongoDBConnect(). A service that started without them would
# write plaintext into collections whose other documents are ciphertext, and nothing would show that
# up until someone read the data back — so it refuses to start instead.
#
# ⚠️ CSFLE_MASTER_KEY_PATH names a 96-byte file that must be THE SAME FILE on every service and on
# marketplace-db-setup. The data keys in the vault are encrypted under it: a different key makes
# every encrypted field on the platform an undecryptable blob. Keep it outside the repo, mode 400.
# There is no escrow and no reset — losing this file loses every personal field, permanently.
CSFLE_MASTER_KEY_PATH=/absolute/path/to/master.key
#
# ⚠️ The namespace is `<the database MONGODB_URI points at>.__keyVault` — the SAME database, never a
# vault database of its own. Every user on this cluster is scoped to one database, so a vault
# anywhere else answers `Unauthorized` on the first createIndex. `yarn test:integration` overrides
# both of these with its own throwaway database and a key minted per run; only the values here are
# used by `yarn dev` and `yarn start`.
CSFLE_KEY_VAULT_NAMESPACE=dbMarketplaceDev.__keyVault

# ── Integration tests: throwaway MongoDB (MONGO_TEST_*) ───────────────────────
#
# `yarn test:integration` ignores MONGODB_URI above and rebuilds it from this block, so the suite
# never touches the dev database. Copy the four user/password values from marketplace-db-setup/.env —
# it is the same cluster and the same two users. The database name is this service’s own.
#
# Two users on purpose, the same split production uses:
#   OWNER — dbOwner. test/integration/globalSetup.mts drops MONGO_TEST_DB and replays every
#           marketplace-db-setup migration with it, so the collections carry the real validators.
#   R/W   — readWrite. The service under test connects with this one, so a resolver that quietly
#           needs more than readWrite fails in the suite instead of in production.
#
# ⚠️ THREE variables name the test database and all three must carry the SAME name:
# MONGO_TEST_DB, MONGO_TEST_AUTH_ADMIN, and the database path of MONGO_TEST_CONN_STRING.
# vitest.mongo.mts refuses to build a URL when they disagree, because it rebuilds the path from
# MONGO_TEST_DB — a connection string naming a different database would still connect, and the
# suite would drop a database that string never mentioned.
#
# The name below belongs to this service alone; no other repo may reuse it, since every
# suite drops its own database.
#
# authSource is therefore the test database itself, NOT `admin`: both users have to be created in
# it, with a role on it — see marketplace-db-setup/setup/mongodb.js. Dropping the database does not
# delete them; MongoDB keeps every user in admin.system.users whatever its auth database is.
#
# Shape: mongodb+srv://<host>/dbMarketplaceTestUserRes   (credentials are injected from the pairs below)
MONGO_TEST_CONN_STRING=
MONGO_TEST_AUTH_ADMIN=dbMarketplaceTestUserRes

# DB OWNER USER
MONGO_TEST_UDBOWNER=
MONGO_TEST_PWDDBOWNER=

# R/W USER
MONGO_TEST_UDBRW=
MONGO_TEST_PWDDBRW=

MONGO_TEST_DB=dbMarketplaceTestUserRes


NODE_ENV=development


# ⚠️ Shorter than marketplace-dev-authenticated-resource's template, and every omission is deliberate —
# this file is the only place the intended variable set is written down, so a leftover here reads as a
# dependency the service does not have. Gone, with the reason:
#
#   UPLOAD_DIR   nothing is uploaded on this tier; no sharp, no clamscan
#   SOCKETLABS_* / EMAIL_FROM / DEV_TEAM_EMAIL / PLATFORM_NAME
#                                              no mail is sent here — registration, verification and
#                                              password recovery all live on 4027
#   REDIRECT_DOMAIN                            nothing redirects; this service answers GraphQL only
#   SAMESITE_COOKIE / KEYGRIP_KEK              no cookie is signed or read here. The refresh cookie is
#                                              minted and consumed by 4031; this tier reads the
#                                              `Authorization: Bearer access:` header and nothing else
#   HIT_STATS                                  unused
#
# ⚠️ Three of those reasons turned out to be platform-wide rather than tier-specific: REDIRECT_DOMAIN,
# SAMESITE_COOKIE and HIT_STATS are read by no `src/` file in any of the nine services and by no
# `dist/` file in either @axiumine package, so they came out of the other eight templates too.
# SAMESITE_COOKIE in particular never set the refresh cookie's SameSite attribute anywhere — that is
# the literal `sameSite: 'Strict'` in @axiumine/koa-utils/dist/lib/tokenOptions.mjs. This file was
# right about all three before the rest of the platform was.
#
# Everything below IS read. `checkRequiredEnv()` in src/index.mts refuses to start without it.

# Shared with all nine services on purpose — it is what lets the single logout service (4030) delete a
# session by token content. The tier discriminator in the session hash, asserted by
# authorizationAuthenticatedResourceHandler, is what keeps an Admin or ShopOwner token out of here.
# (REDIS_KEY is set above, with the rest of the Redis block.)

# Optional: an empty or missing DSN leaves the Sentry SDK inert and the service still boots.
# Deliberately absent from REQUIRED_ENV_VARS in src/index.mts — do not add it back.
DSN="https://xxxxxxxxxxxxxx@bugsink.lan/1"

